<?xml version="1.0" encoding="utf-8"?>
<!-- Contenedor principal que organiza los elementos en la pantalla -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ListaPreciosActivity">

    <!-- Inclusión del Toolbar reutilizable definido en otro archivo -->
    <include
        layout="@layout/layout_toolbar"
        android:id="@+id/toolbar_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ScrollView permite que la tabla se pueda desplazar si hay muchos datos -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar_container"
        app:layout_constraintBottom_toTopOf="@id/btnRegresar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- TableLayout organiza la información en filas y columnas -->
        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stretchColumns="1">

            <!-- Fila de encabezado con color de fondo principal -->
            <TableRow
                android:background="?attr/colorPrimary"
                android:padding="8dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Modelo de Auto"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_weight="1"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Precio (USD)"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:gravity="end"/>
            </TableRow>

            <!-- Filas de datos con colores alternos para mejorar la lectura -->
            <TableRow android:padding="12dp" android:background="#F5F5F5">
                <TextView android:text="Nissan Versa 2024" android:textSize="15sp"/>
                <TextView android:text="$18,500" android:gravity="end" android:textSize="15sp" android:textStyle="bold"/>
            </TableRow>

            <TableRow android:padding="12dp">
                <TextView android:text="Toyota Corolla 2024" android:textSize="15sp"/>
                <TextView android:text="$22,000" android:gravity="end" android:textSize="15sp" android:textStyle="bold"/>
            </TableRow>

            <TableRow android:padding="12dp" android:background="#F5F5F5">
                <TextView android:text="Honda Civic 2024" android:textSize="15sp"/>
                <TextView android:text="$24,900" android:gravity="end" android:textSize="15sp" android:textStyle="bold"/>
            </TableRow>

            <TableRow android:padding="12dp">
                <TextView android:text="Mazda 3 2024" android:textSize="15sp"/>
                <TextView android:text="$23,500" android:gravity="end" android:textSize="15sp" android:textStyle="bold"/>
            </TableRow>

            <TableRow android:padding="12dp" android:background="#F5F5F5">
                <TextView android:text="Volkswagen Jetta 2024" android:textSize="15sp"/>
                <TextView android:text="$21,800" android:gravity="end" android:textSize="15sp" android:textStyle="bold"/>
            </TableRow>

            <TableRow android:padding="12dp">
                <TextView android:text="Chevrolet Aveo 2024" android:textSize="15sp"/>
                <TextView android:text="$16,200" android:gravity="end" android:textSize="15sp" android:textStyle="bold"/>
            </TableRow>

            <TableRow android:padding="12dp" android:background="#F5F5F5">
                <TextView android:text="Kia Forte 2024" android:textSize="15sp"/>
                <TextView android:text="$20,500" android:gravity="end" android:textSize="15sp" android:textStyle="bold"/>
            </TableRow>

        </TableLayout>
    </ScrollView>

    <!-- Botón para cerrar la actividad y volver a la pantalla anterior -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRegresar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="Regresar"
        app:icon="@drawable/ic_back"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>