<?xml version="1.0" encoding="utf-8"?>
<!-- Contenedor principal que organiza los elementos en la pantalla -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ListaPreciosActivity">

    <!-- Inclusión del Toolbar reutilizable definido en otro archivo -->
    <include
        layout="@layout/layout_toolbar"
        android:id="@+id/toolbar_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ScrollView permite que la tabla se pueda desplazar si hay muchos datos -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar_container"
        app:layout_constraintBottom_toTopOf="@id/btnRegresar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- TableLayout organiza la información en filas y columnas -->
        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stretchColumns="0">

            <!-- Fila de encabezado -->
            <TableRow
                android:background="?attr/colorPrimary"
                android:padding="8dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Modelo de Auto"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="16sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Precio (USD)"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:gravity="end"
                    android:layout_marginStart="16dp"/>
            </TableRow>

            <!-- Filas con campos EditText para permitir edición -->
            <TableRow android:padding="4dp" android:background="#F5F5F5" android:gravity="center_vertical">
                <EditText 
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nissan Versa 2024" 
                    android:textSize="15sp"
                    android:background="@android:color/transparent"
                    android:padding="8dp"/>
                <EditText 
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="18500" 
                    android:gravity="end" 
                    android:textSize="15sp" 
                    android:textStyle="bold"
                    android:inputType="numberDecimal"
                    android:background="@android:color/transparent"
                    android:padding="8dp"
                    android:layout_marginStart="16dp"/>
            </TableRow>

            <TableRow android:padding="4dp" android:gravity="center_vertical">
                <EditText 
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Toyota Corolla 2024" 
                    android:textSize="15sp"
                    android:background="@android:color/transparent"
                    android:padding="8dp"/>
                <EditText 
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="22000" 
                    android:gravity="end" 
                    android:textSize="15sp" 
                    android:textStyle="bold"
                    android:inputType="numberDecimal"
                    android:background="@android:color/transparent"
                    android:padding="8dp"
                    android:layout_marginStart="16dp"/>
            </TableRow>

            <TableRow android:padding="4dp" android:background="#F5F5F5" android:gravity="center_vertical">
                <EditText 
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Honda Civic 2024" 
                    android:textSize="15sp"
                    android:background="@android:color/transparent"
                    android:padding="8dp"/>
                <EditText 
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="24900" 
                    android:gravity="end" 
                    android:textSize="15sp" 
                    android:textStyle="bold"
                    android:inputType="numberDecimal"
                    android:background="@android:color/transparent"
                    android:padding="8dp"
                    android:layout_marginStart="16dp"/>
            </TableRow>

            <TableRow android:padding="4dp" android:gravity="center_vertical">
                <EditText 
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mazda 3 2024" 
                    android:textSize="15sp"
                    android:background="@android:color/transparent"
                    android:padding="8dp"/>
                <EditText 
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="23500" 
                    android:gravity="end" 
                    android:textSize="15sp" 
                    android:textStyle="bold"
                    android:inputType="numberDecimal"
                    android:background="@android:color/transparent"
                    android:padding="8dp"
                    android:layout_marginStart="16dp"/>
            </TableRow>

            <TableRow android:padding="4dp" android:background="#F5F5F5" android:gravity="center_vertical">
                <EditText 
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Volkswagen Jetta 2024" 
                    android:textSize="15sp"
                    android:background="@android:color/transparent"
                    android:padding="8dp"/>
                <EditText 
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="21800" 
                    android:gravity="end" 
                    android:textSize="15sp" 
                    android:textStyle="bold"
                    android:inputType="numberDecimal"
                    android:background="@android:color/transparent"
                    android:padding="8dp"
                    android:layout_marginStart="16dp"/>
            </TableRow>

        </TableLayout>
    </ScrollView>

    <!-- Botón para cerrar la actividad -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRegresar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="Regresar"
        app:icon="@drawable/ic_back"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>